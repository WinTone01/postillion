@component('components/layout', { title: (chat ? chat.title : 'Chat') + ' — Postillion', captchaScript: false })
  <div class="card wide" data-chat-id="{{ chat ? chat.id : '' }}" data-head-seq="{{ headSeq }}">
    <div class="head">
      <h1>{{ chat ? chat.title : 'Chat' }}</h1>
      <a class="quiet" href="/app">Workspace</a>
    </div>

    @if (chat && chat.location)
      <p class="sub">{{ chat.location }}</p>
    @end

    @if (unreachable)
      {{-- Ulaşılamamak ile boş olmak AYRI: ilki arıza. --}}
      <ul class="errors">
        <li>The server could not be reached, so the transcript is unavailable.</li>
      </ul>
    @elseif (!messages.length)
      <p class="empty">No messages in this chat yet.</p>
    @else
      <ol class="transcript">
        @each (message in messages)
          <li class="msg {{ message.role }}">
            <span class="who">{{ message.role === 'user' ? 'You' : 'Agent' }}</span>
            @each (part in message.parts)
              @if (part.kind === 'text')
                <p class="text">{{ part.text }}</p>
              @elseif (part.kind === 'error')
                <p class="part-error">{{ part.message }}</p>
              @elseif (part.kind === 'tool')
                <p class="tool">
                  {{ part.call && part.call.command ? part.call.command : (part.call && part.call.path ? part.call.path : 'tool') }}
                  @if (!part.resolved)
                    <span class="pending">running</span>
                  @end
                </p>
              @end
            @end
          </li>
        @end
      </ol>
    @end

    @if (flashMessages.has('errorsBag'))
      <ul class="errors">
        @each (message in (flashMessages.get('errorsBag') ?? {}))
          <li>{{ message }}</li>
        @end
      </ul>
    @end

    @if (chat && chat.deviceOnline)
      <form class="row send" method="POST" action="/app/chats/{{ chat.id }}/send">
        {{ csrfField() }}
        <input type="text" name="prompt" placeholder="Write a message…" required
               maxlength="20000" value="{{ flashMessages.get('prompt') ?? '' }}" />
        <button class="btn narrow" type="submit">Send</button>
      </form>
    @end

    @if (chat && livenessKnown && !chat.deviceOnline)
      {{-- Yazma kapalıysa SEBEBİ yazılı olmalı: kaybolmuş bir kutu soru
           bırakır. Okumak zaten çalışıyor. --}}
      <p class="notice">
        This chat's device is off. You can read the history; writing needs the
        device to be running.
      </p>
    @end
  </div>
@end
