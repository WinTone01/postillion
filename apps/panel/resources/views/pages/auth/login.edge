@component('components/layout', { title: 'Log in — Postillion', captchaScript: true })
  <form class="card" method="POST" action="/login">
    {{ csrfField() }}
    <h1>Log in</h1>
    <p class="sub">Continue with your Postillion account.</p>

    @if (flashMessages.has('notice'))
      <p class="notice">{{ flashMessages.get('notice') }}</p>
    @end

    @if (flashMessages.has('errorsBag') || flashMessages.has('errors'))
      <ul class="errors">
        @each (message in (flashMessages.get('errorsBag') ?? {}))
          <li>{{ message }}</li>
        @end
        @each ((messages, field) in (flashMessages.get('errors') ?? {}))
          @each (message in messages)
            <li>{{ message }}</li>
          @end
        @end
      </ul>
    @end

    <label class="field">
      <span>E-mail</span>
      <input type="email" name="email" required autocomplete="email"
             value="{{ flashMessages.get('email') ?? '' }}" />
    </label>

    <label class="field">
      <span>Password</span>
      <input type="password" name="password" required autocomplete="current-password" />
    </label>

    @if (turnstileSiteKey)
      {{-- `data-response-field-name` ŞART. Turnstile jetonu varsayılan olarak
           `cf-turnstile-response` altında gönderiyor ama adonis-captcha-guard
           onu `token` adıyla arıyor; ad tutmadığında doğrulama, widget çözülmüş
           olsa bile 400 "Request is missing the token param" ile düşüyor. --}}
      <div class="cf-turnstile" data-sitekey="{{ turnstileSiteKey }}"
           data-response-field-name="token"></div>
    @end

    <button class="btn" type="submit">Log in</button>
    <p class="alt">No account yet? <a href="/register">Sign up</a></p>
  </form>
@end
