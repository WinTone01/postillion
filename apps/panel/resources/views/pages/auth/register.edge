@layout('layouts/app', { title: 'Kayıt — Postillion', captchaScript: true })
@section('content')
  <form class="card" method="POST" action="/register">
    {{ csrfField() }}
    <h1>Hesap oluştur</h1>
    <p class="sub">Sohbetlerinize webden devam edin.</p>

    @if (flashMessages.has('errorsBag') || flashMessages.has('errors'))
      <ul class="errors">
        @each (message in (flashMessages.get('errorsBag') ?? {}))
          <li>{{ message }}</li>
        @end
        @each ((messages, field) in (flashMessages.get('errors') ?? {}))
          @each (message in messages)
            <li>{{ message }}</li>
          @end
        @end
      </ul>
    @end

    <label class="field">
      <span>E-posta</span>
      <input type="email" name="email" required autocomplete="email"
             value="{{ flashMessages.get('email') ?? '' }}" />
    </label>

    <label class="field">
      <span>Parola</span>
      <input type="password" name="password" required autocomplete="new-password" />
    </label>

    {{-- Turnstile widget'ı: doğrulama sunucuda, bu yalnızca jetonu üretiyor. --}}
    <div class="cf-turnstile" data-sitekey="{{ turnstileSiteKey }}"></div>

    <button class="btn" type="submit">Kayıt ol</button>
    <p class="alt">Hesabınız var mı? <a href="/login">Giriş yapın</a></p>
  </form>
@end
