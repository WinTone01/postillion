@component('components/layout', { title: 'Sign up — Postillion', captchaScript: true })
  <form class="card" method="POST" action="/register">
    {{ csrfField() }}
    <h1>Create an account</h1>
    <p class="sub">Pick up your chats from the web.</p>

    @if (flashMessages.has('errorsBag') || flashMessages.has('errors'))
      <ul class="errors">
        @each (message in (flashMessages.get('errorsBag') ?? {}))
          <li>{{ message }}</li>
        @end
        @each ((messages, field) in (flashMessages.get('errors') ?? {}))
          @each (message in messages)
            <li>{{ message }}</li>
          @end
        @end
      </ul>
    @end

    <label class="field">
      <span>E-mail</span>
      <input type="email" name="email" required autocomplete="email"
             value="{{ flashMessages.get('email') ?? '' }}" />
    </label>

    <label class="field">
      <span>Password</span>
      <input type="password" name="password" required autocomplete="new-password"
             minlength="12" />
    </label>

    @if (turnstileSiteKey)
      {{-- Bkz. login.edge: alan adı `token` olmak ZORUNDA. --}}
      <div class="cf-turnstile" data-sitekey="{{ turnstileSiteKey }}"
           data-response-field-name="token"></div>
    @end

    <button class="btn" type="submit">Sign up</button>
    <p class="alt">Already have an account? <a href="/login">Log in</a></p>
  </form>
@end
