@component('components/layout', { title: 'Verify your e-mail — Postillion' })
  <div class="card">
    <h1>Verify your e-mail</h1>
    <p class="sub">
      We sent a verification link to <strong>{{ email }}</strong>.
      Follow it to reach the panel.
    </p>

    @if (flashMessages.has('notice'))
      <p class="notice">{{ flashMessages.get('notice') }}</p>
    @end

    @if (flashMessages.has('errorsBag'))
      <ul class="errors">
        @each (message in (flashMessages.get('errorsBag') ?? {}))
          <li>{{ message }}</li>
        @end
      </ul>
    @end

    {{-- Posta sunucusu yapılandırılmamışsa "yeniden gönder" yalan söylerdi. --}}
    @if (mailConfigured)
      <form method="POST" action="/verify/resend">
        {{ csrfField() }}
        <button class="btn" type="submit">Send the e-mail again</button>
      </form>
    @else
      <p class="alt">E-mail delivery is not configured on this installation.</p>
    @end

    <form method="POST" action="/logout">
      {{ csrfField() }}
      <p class="alt">Different account? <button class="linkish" type="submit">Log out</button></p>
    </form>
  </div>
@end
