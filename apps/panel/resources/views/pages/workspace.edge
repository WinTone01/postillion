@component('components/layout', { title: 'Postillion', captchaScript: false })
  <div class="card wide">
    <div class="head">
      <h1>Workspace</h1>
      <a class="quiet" href="/app/tokens">Device tokens</a>
    </div>

    @if (!devices.length && !chats.length)
      <p class="empty">
        No device has connected yet.
        <a href="/app/tokens">Generate a token</a> and enter it on the device
        under <em>Settings → Sync</em>.
      </p>
    @end

    @if (devices.length)
      <h2>Devices</h2>
      <ul class="tokens">
        @each (device in devices)
          <li>
            <div>
              <span class="name">{{ device.name }}</span>
              <span class="meta">{{ device.platform }}</span>
            </div>
            @if (!livenessKnown)
              {{-- Sunucuya ulaşılamıyor: "çevrimdışı" demek yanlış olurdu. --}}
              <span class="dot unknown">status unknown</span>
            @elseif (device.online)
              <span class="dot online">online</span>
            @else
              <span class="dot offline">offline</span>
            @end
          </li>
        @end
      </ul>
    @end

    @if (chats.length)
      <h2>Chats</h2>
      <ul class="tokens">
        @each (chat in chats)
          <li>
            <div>
              <a class="name link" href="/app/chats/{{ chat.id }}">{{ chat.title }}</a>
              <span class="meta">{{ chat.location }}</span>
            </div>
            @if (livenessKnown && !chat.deviceOnline)
              {{-- Geçmiş okunabilir, yazmak için cihaz gerekiyor. Sebebi
                   yazılı olmalı: kaybolmuş bir buton soru bırakır. --}}
              <span class="dot offline">device is off</span>
            @end
          </li>
        @end
      </ul>
    @end
  </div>
@end
