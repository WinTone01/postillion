# Panel ortam değişkenleri.
#
# Turnstile anahtarları BOŞ bırakılabilir: o zaman captcha doğrulaması
# atlanıyor (geliştirme ve test). Üretimde MUTLAKA doldurun — boş bırakmak
# kayıt formunu botlara açık bırakır.

TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development
SESSION_DRIVER=cookie
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app
# Eşitleme sunucusu. Panel listeleri veritabanından okuyor ama CANLILIK
# (hangi cihaz açık) sunucunun belleğinde — buradan soruluyor.
#
# Ayarlanmazsa panel yine çalışıyor: listeler görünüyor, cihaz durumu
# "bilinmiyor" olarak gösteriliyor. "Çevrimdışı" DEMİYOR — açık bir cihazı
# kapalı göstermek yanlış bilgi olurdu.
# Veritabanı. Dağıtımda TEK dize yeterli ve eşitleme sunucusuyla aynısı
# olmalı; aşağıdaki parçalı DB_* değişkenleri yerel geliştirme için.
# DATABASE_URL=postgres://kullanici:parola@host:5432/veritabani

POSTILLION_SERVER_URL=
POSTILLION_SERVER_TOKEN=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# E-posta doğrulama (Mailtrap).
#
# BOŞ bırakılabilir: o zaman doğrulama postası hiç gönderilmiyor ve panel
# doğrulama ŞARTI KOŞMUYOR — koşsaydı bağlantı ulaşmayacağı için kimse
# içeri giremezdi. Üretimde doldurun.
#
# APP_URL doğrulama bağlantısının mutlak adresi ve boş bırakılamaz: boşken
# bağlantı `/verify/1?signature=...` olarak gidiyor, posta istemcisi onu
# adres çubuğuna koyuyor ve tarayıcı ilk parçayı SUNUCU ADI sanıyor
# (`https://verify/1`). Hiçbir yerde hata görünmüyor, bağlantı yalnızca
# açılmıyor. Bu yüzden APP_URL yokken posta hiç gönderilmiyor.
#
# Şema dahil yazın (https://panel.ornek.com); şemasız bir değer
# `https://` ile tamamlanıyor.
APP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=noreply@postillion.net
MAIL_FROM_NAME=Postillion
