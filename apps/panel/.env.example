# Panel ortam değişkenleri.
#
# Turnstile anahtarları BOŞ bırakılabilir: o zaman captcha doğrulaması
# atlanıyor (geliştirme ve test). Üretimde MUTLAKA doldurun — boş bırakmak
# kayıt formunu botlara açık bırakır.

TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development
SESSION_DRIVER=cookie
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app
# Eşitleme sunucusu. Panel listeleri veritabanından okuyor ama CANLILIK
# (hangi cihaz açık) sunucunun belleğinde — buradan soruluyor.
#
# Ayarlanmazsa panel yine çalışıyor: listeler görünüyor, cihaz durumu
# "bilinmiyor" olarak gösteriliyor. "Çevrimdışı" DEMİYOR — açık bir cihazı
# kapalı göstermek yanlış bilgi olurdu.
POSTILLION_SERVER_URL=
POSTILLION_SERVER_TOKEN=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=