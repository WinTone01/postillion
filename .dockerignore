# Derleme bağlamını küçük tutuyor. `target/` tek başına gigabaytlarca ve
# bağlamın tamamı her derlemede daemon'a aktarılıyor.
target/
**/target/

.git/
ignore/
node_modules/
edge/dist/
dist/
build/

# Sırlar bağlama HİÇ girmesin: derleme bağlamına giren bir dosya, imaja
# kopyalanmasa bile katman geçmişinde iz bırakabiliyor.
.env
.env.*
*.pem
*.key

# Sunucunun ihtiyacı olmayan taraflar.
#
# `apps/landing/` BURAYA GİRMİYOR: landing imajı da aynı kökü bağlam olarak
# kullanıyor ve buradan dışlanması onu görünmez yapardı. 1,8 MB, sunucu
# derlemesine yükü ihmal edilebilir.
#
# `crates/rpc/` de girmiyor: cihaz rölesinin çerçeve codec'i orada ve sunucu
# ona bağımlı. Kendisi yalnızca `proto` ile `sync`'e bağlı, yani ağır bir şey
# getirmiyor.
apps/ios/
apps/postillion/
crates/ui/
crates/engine/
crates/harness/
crates/update/
crates/syntax/
